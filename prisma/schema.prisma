generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native","debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


model Track {
  id        Int        @id @default(autoincrement())
  title     String
  artist    String
  filename  String     // storage path in Supabase: "tracks/filename.mp3"
  createdAt DateTime   @default(now())
  album     String?
  imageUrl  String?    // full public URL from Supabase Storage
  duration  Int?       // seconds
  genre       String?
  favorites Favorite[]
  reviews    Review[]
  rating    Float?
}

model User {
  id              Int        @id @default(autoincrement())
  username        String?    @unique   // optional — Telegram users may not set one
  password        String?             // optional — Telegram users have no password
     
  telegramId      String?     @unique  // Telegram user ID (string — avoids int overflow)
  telegramUsername String?            // display name pulled from Telegram
  telegramName String?
  telegramPhotoUrl String?
  telegramAuthVersion Int @default(0)
  telegramLinkCode TelegramLinkCode?

  isAdmin         Boolean    @default(false)
  profileImageUrl String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  favorites       Favorite[]
  complaints      Complaint[]
  reviews         Review[]
  playbackSession PlaybackSession?
  playbackDevices PlaybackDevice[]
}

model TelegramLinkCode {
  userId    Int      @id
  codeHash  String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model PlaybackSession {
  userId          Int       @id
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  version         Int       @default(0)
  activeDeviceId  String?   @db.Uuid
  pendingDeviceId String?   @db.Uuid
  leaseUntil      DateTime?
  handoffResume   Boolean   @default(false)
  trackId         Int?
  duration        Int?
  queue           Int[]     @default([])
  queueIndex      Int       @default(-1)
  shuffleOrder    Int[]     @default([])
  playing         Boolean   @default(false)
  position        Float     @default(0)
  positionAt      DateTime  @default(now())
  shuffle         Boolean   @default(false)
  repeat          String    @default("none")
}

model PlaybackDevice {
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  id         String   @db.Uuid
  keyHash    String   @db.Char(64)
  name       String
  platform   String
  lastSeenAt DateTime @default(now())

  @@id([userId, id])
  @@index([userId, lastSeenAt])
}

model Favorite {
  favoriteId Int      @id @default(autoincrement())
  trackId    Int
  userId     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])
  track      Track    @relation(fields: [trackId], references: [id])

  @@unique([userId, trackId])
  @@index([trackId])
}

model Complaint {
  id         Int      @id @default(autoincrement())
  userId     Int
  message    String
  status     String   @default("ожидание") // Возможные значения: pending, resolved, rejected
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
}


model Review {
  id         Int      @id @default(autoincrement())
  userId     Int
  trackId    Int
  content    String
  rating     Int      // Рейтинг (1-5)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])
  track      Track    @relation(fields: [trackId], references: [id])

  @@index([trackId])
  @@index([userId])
}
