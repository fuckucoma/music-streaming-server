generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native","debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


model Track {
  id        Int        @id @default(autoincrement())
  title     String
  artist    String
  filename  String     // storage path in Supabase: "tracks/filename.mp3"
  createdAt DateTime   @default(now())
  album     String?
  imageUrl  String?    // full public URL from Supabase Storage
  duration  Int?       // seconds
  genre       String?
  favorites Favorite[]
  reviews    Review[]
  rating    Float?
}

model User {
  id              Int        @id @default(autoincrement())
  username        String?    @unique   // optional — Telegram users may not set one
  password        String?             // optional — Telegram users have no password
     
  telegramId      String     @unique  // Telegram user ID (string — avoids int overflow)
  telegramUsername String?            // display name pulled from Telegram
  telegramName String?
  telegramPhotoUrl String?

  isAdmin         Boolean    @default(false)
  profileImageUrl String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  favorites       Favorite[]
  complaints      Complaint[]
  reviews         Review[]
}

model Favorite {
  favoriteId Int      @id @default(autoincrement())
  trackId    Int
  userId     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])
  track      Track    @relation(fields: [trackId], references: [id])

  @@unique([userId, trackId])
}

model Complaint {
  id         Int      @id @default(autoincrement())
  userId     Int
  message    String
  status     String   @default("ожидание") // Возможные значения: pending, resolved, rejected
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])
}


model Review {
  id         Int      @id @default(autoincrement())
  userId     Int
  trackId    Int
  content    String
  rating     Int      // Рейтинг (1-5)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])
  track      Track    @relation(fields: [trackId], references: [id])
}
